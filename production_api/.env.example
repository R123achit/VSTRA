# Application Settings
APP_NAME=Product Search API
APP_VERSION=2.0.0
API_PREFIX=/api/v1
DEBUG=False

# Server Settings
HOST=0.0.0.0
PORT=8000
WORKERS=4

# CORS Settings (comma-separated origins)
CORS_ORIGINS=*

# Search Engine Paths
FAISS_INDEX_PATH=C:\Users\rachi\VSTRA\Data\product_index.faiss
EMBEDDINGS_PATH=C:\Users\rachi\VSTRA\Data\embeddings.npy
PRODUCTS_CSV_PATH=C:\Users\rachi\VSTRA\Data\cleaned_products.csv
MODEL_NAME=all-MiniLM-L6-v2

# Search Limits
MAX_TOP_K=50
DEFAULT_TOP_K=10
MAX_BATCH_QUERIES=50

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Caching
ENABLE_CACHE=True
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Redis (Optional)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=False
